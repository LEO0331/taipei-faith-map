# Public build-time switches. Solo interaction needs no service or account.
VITE_FAITH_MOMENTS_ENABLED=true
# Shared services stay disabled until configured and independently verified.
VITE_QUIET_PRESENCE_ENABLED=false
VITE_QUIET_CORNER_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional public Turnstile site key; the matching secret belongs only in Supabase.
VITE_SUPABASE_TURNSTILE_SITE_KEY=
