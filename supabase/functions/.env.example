# Server-only template. Never place these values in frontend VITE_ configuration.
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEYS and SUPABASE_SECRET_KEYS are injected by
# Supabase. The handler selects each injected dictionary's "default" key.
QUIET_ALLOWED_ORIGINS=https://leo0331.github.io
QUIET_IDENTITY_HASH_SECRET=
QUIET_TURNSTILE_SECRET=
QUIET_TURNSTILE_HOSTNAMES=leo0331.github.io
QUIET_CAPTCHA_REQUIRED=true

# Local internal gateway support only. Hosted projects cannot bypass CAPTCHA.
QUIET_LOCAL_TEST_MODE=false
